/*
 * CLINK-Armband: KKM W59 mit nRF52832-QFAA (512 KB Flash, 64 KB RAM).
 * Quelle: KKM pca10040_W59u.h und Schaltplan K59_52832 V1.3 (2021-02-22).
 *
 * Nicht bestückt (NC laut Schaltplan/Release-Note): SPI-Flash FM25W04, Summer.
 */

/dts-v1/;
#include <nordic/nrf52832_qfaa.dtsi>
#include "clink_w59-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "CLINK W59 (KKM W59, nRF52832)";
	compatible = "clink,w59";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
		zephyr,settings-partition = &settings_partition;
	};

	leds {
		compatible = "gpio-leds";
		led_red: led_0 {
			gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
			label = "LED rot";
		};
		led_green: led_1 {
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
			label = "LED gruen";
		};
	};

	buttons {
		compatible = "gpio-keys";
		touch: touch_0 {
			/* Touch-Controller TTP233D, Ausgang aktiv low */
			gpios = <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Touch-Taste";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	zephyr,user {
		/* Vibrationsmotor über MOSFET AO3400 */
		motor-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
		/* USB-Ladekontakte erkannt (5 V über Teiler 2,2M/2,2M) */
		usb-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
		/* Akkuspannung über Teiler 2,2M/2,2M an AIN3 (P0.05) */
		io-channels = <&adc 3>;
	};

	aliases {
		led0 = &led_green;
		led1 = &led_red;
		sw0 = &touch;
		accel0 = &lis3dh;
		watchdog0 = &wdt0;
	};
};

&reg {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";

	/* LIS3DH: CS (P0.14) high = I2C-Modus, SA0 (P0.13) high = Adresse 0x19 */
	acc_cs_hog {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_HIGH>;
		output-high;
	};

	acc_sa0_hog {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		/* Hochohmiger Teiler (1,1 MΩ Quellwiderstand): lange Erfassungszeit */
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN3>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	lis3dh: lis3dh@19 {
		compatible = "st,lis2dh";
		reg = <0x19>;
		/* INT1 = P0.16, INT2 = P0.15 */
		irq-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>, <&gpio0 15 GPIO_ACTIVE_HIGH>;
		disconnect-sdo-sa0-pull-up;
	};
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "disabled";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * Pilot: Firmware ab Adresse 0, ohne Bootloader (Flashen per SWD).
		 * Für Updates per Bluetooth (MCUboot) wird code_partition später
		 * in mcuboot + image-0 + image-1 aufgeteilt; settings und log bleiben.
		 */
		code_partition: partition@0 {
			label = "code";
			reg = <0x00000000 0x0007a000>;
		};

		settings_partition: partition@7a000 {
			label = "settings";
			reg = <0x0007a000 0x00002000>;
		};

		/* Begegnungen: 16 KB = 1024 Einträge à 16 Byte */
		log_partition: partition@7c000 {
			label = "encounters";
			reg = <0x0007c000 0x00004000>;
		};
	};
};
